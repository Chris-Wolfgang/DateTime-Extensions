<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFrameworks>net8.0;net10.0;net11.0</TargetFrameworks>
		<Nullable>enable</Nullable>

		<!-- Every project in this repo states this explicitly rather than leaning on the
		     SDK default. The library and the unit tests multi-target down to net462, where
		     implicit usings do not apply at all, so enabling them anywhere would leave the
		     same source compiling with different usings in scope per TFM. -->
		<ImplicitUsings>disable</ImplicitUsings>

		<!-- These two must stay in the project file. Passed on the command line they become
		     global properties and flow into the referenced library, which multi-targets
		     net462 and then fails with NETSDK1124 ("Trimming assemblies requires .NET Core
		     3.0 or higher"). The per-TFM publish command in the "Native AOT publish + run"
		     jobs therefore passes neither.

		     PublishAot is set only in the per-framework (inner) evaluation. Those jobs always
		     publish with an explicit framework, so they still get a native binary. The
		     canonical AOT smoke workflow finds projects by evaluating PublishAot WITHOUT a framework
		     and publishes them without -f, which a project with three target frameworks cannot
		     do. Leaving the outer evaluation empty keeps this harness out of the canonical job,
		     which runs tests/*.Tests.Aot instead. This bridge ends when tests/AotSmoke is
		     deleted (Tests.Aot conversion plan, 2026-11-20). -->
		<PublishAot Condition="'$(TargetFramework)' != ''">true</PublishAot>
		<PublishTrimmed>true</PublishTrimmed>
		<IsPackable>false</IsPackable>
		<IsTestProject>false</IsTestProject>

		<!-- InvariantGlobalization is deliberately NOT set. This library's parameterless
		     FirstOfWeek/EndOfWeek read CultureInfo.CurrentCulture.DateTimeFormat.FirstDayOfWeek,
		     so an AOT binary without culture data would silently answer as if every culture
		     were invariant. Program.cs asserts a de-DE answer precisely so that regression
		     fails the smoke test instead of reaching a consumer. -->

		<!-- Throwaway AOT smoke harness - not shipped, and not held to the
		     warnings-as-errors bar the shipped library is held to.
		     Directory.Build.props applies TWAE in Release by walking up the
		     directory tree, not by solution membership, so this is an explicit
		     opt-out rather than a consequence of being outside the .slnx. -->
		<TreatWarningsAsErrors>false</TreatWarningsAsErrors>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\src\Wolfgang.Extensions.DateTime\Wolfgang.Extensions.DateTime.csproj" />
	</ItemGroup>

</Project>
